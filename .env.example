# Google Sheets - Service Account (conteúdo completo do JSON, não o caminho do arquivo)
# Exemplo: GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"seu-projeto",...}

# Planilha de Registros (leitura)
GSHEET_RECORDS_SPREADSHEET_ID=12LHZyAX7WzLvlmUzS1lzqc1qgNSX_xUPymZw7paTupY
GSHEET_RECORDS_SHEET_NAME=IGT ULTIMATE| Desafios | Clientes Pagantes

# Planilha de Pontuação (escrita)
GSHEET_TOTALS_SPREADSHEET_ID=1JKrn8IYtRZZI7Wso6t5uRUX1bkzlve7fvERZDbTrBIQ
GSHEET_TOTALS_SHEET_NAME=PONTUAÇÃO

# Planilha oficial de Desafios Pontuais (leitura posicional A:I)
GSHEET_DESAFIOS_SPREADSHEET_ID=id-da-planilha-de-desafios
GSHEET_DESAFIOS_SHEET_NAME=nome-da-aba-de-desafios

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-aqui

# Pontuação
POINTS_PER_COACHING_INDIVIDUAL=30
POINTS_PER_DESAFIO_SUBMISSION=10
# Pontos individuais do coach por submissão aprovada de desafio (separado do
# valor de clã acima)
POINTS_PER_DESAFIO_SUBMISSION_COACH=100

# Autenticação (HTTP Basic) — OBRIGATÓRIA em produção; sem APP_PASSWORD o app não sobe.
APP_USER=admin
APP_PASSWORD=troque-por-uma-senha-forte
# Apenas dev local (desliga o login). Nunca em produção.
# APP_AUTH_DISABLED=true

# CORS — origens extras separadas por vírgula. Em produção (same-origin) deixe
# vazio/omitido; o default libera só o Vite local (localhost:5173).
# CORS_ORIGINS=https://pontos.seudominio.com

# Backend (dev local — python main.py; no Docker a porta vem de PORT, default 8080)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (dev local apenas — em produção frontend e backend são same-origin)
VITE_API_BASE_URL=http://localhost:8000

# Groq LLM Agent Configuration
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

GROQ_TEMPERATURE=0.0

